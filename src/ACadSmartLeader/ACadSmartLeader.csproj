<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ACadSmartLeader</AssemblyName>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ACadSmartLeader.Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../../external/acadPaletteSetXDATA/src/AcadPaletteSetXData.Core/*.cs" Link="PaletteCore/%(Filename)%(Extension)" />
    <Compile Include="../../external/acadPaletteSetXDATA/src/AcadPaletteSetXData.AutoCAD/AutoCadDataReader.cs" Link="PaletteAutoCAD/AutoCadDataReader.cs" />
    <Compile Include="../../external/acadPaletteSetXDATA/src/AcadPaletteSetXData.AutoCAD/AutoCadSchemaNod.cs" Link="PaletteAutoCAD/AutoCadSchemaNod.cs" />
    <PackageReference Include="AutoCAD.NET" Version="[24.0.0]" Condition="'$(TargetFramework)' == 'net48'" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET" Version="[25.0.1]" Condition="'$(TargetFramework)' == 'net8.0-windows'" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" Condition="'$(TargetFramework)' == 'net48'" PrivateAssets="all" />
    <PackageReference Include="NCalc" Version="[7.4.0]" PrivateAssets="all" />
    <None Include="../../examples/demo-schema.json" Link="demo-schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/label-rules.json" Link="label-rules.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="EmbedRuntimeAssemblies" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_RuntimeAssemblyToEmbed Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll'" />
      <EmbeddedResource Include="@(_RuntimeAssemblyToEmbed)" LogicalName="Embedded.%(Filename)%(Extension)" WithCulture="false" Type="Non-Resx" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" />
    </ItemGroup>
  </Target>
</Project>
